.vscode/**
.vscode-test.mjs
src/**
test/**
out/**
esbuild.js
tsconfig.json
*.map
.gitignore
node_modules/**
!node_modules/papaparse/**
# Only sql.js's WASM runtime is needed at runtime (loaded via
# require.resolve('sql.js/dist/sql-wasm.wasm') in sqliteParser.ts) --
# excluding its many other dist variants (asm.js, debug, browser, worker
# builds, zip archives) keeps the package ~30x smaller than a blanket
# `!node_modules/sql.js/**` would. Note: vsce's .vscodeignore matching
# (see @vscode/vsce's collectFiles) isn't real gitignore semantics -- it's
# "keep a file if it matches ANY negate line", with no directory-level
# re-include/last-match-wins precedence. A `!node_modules/sql.js/**`-style
# broad re-include line would silently defeat every exclusion below it, so
# list exactly the files actually needed instead of trying to negate a
# subtraction from a broad include.
!node_modules/sql.js/package.json
!node_modules/sql.js/dist/sql-wasm.js
!node_modules/sql.js/dist/sql-wasm.wasm
# @duckdb/node-api is pure JS (its lib/**/*.js), needed at runtime.
# @duckdb/node-bindings is a thin platform dispatcher; the actual native
# engine (duckdb.node + libduckdb.{dylib,so}/duckdb.dll) ships in a
# per-platform @duckdb/node-bindings-<platform-arch> package that npm only
# installs the matching one of (see esbuild.js's comment on why both
# packages are kept external instead of bundled). Same flat-negate caveat
# as sql.js above -- list exactly what's needed, no broad re-include.
!node_modules/@duckdb/node-api/package.json
!node_modules/@duckdb/node-api/lib/**/*.js
!node_modules/@duckdb/node-bindings/package.json
!node_modules/@duckdb/node-bindings/duckdb.js
!node_modules/@duckdb/node-bindings-*/package.json
!node_modules/@duckdb/node-bindings-*/duckdb.node
!node_modules/@duckdb/node-bindings-*/*.dylib
!node_modules/@duckdb/node-bindings-*/*.so
!node_modules/@duckdb/node-bindings-*/*.dll
coverage/**
.husky/**
.claude/**
.c8rc.json
.nvmrc
CLAUDE.md
eslint.config.js
scripts/**
