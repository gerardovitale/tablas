{
  "reporter": ["text", "html"],
  "include": ["src/**/*.ts", "src/webview/**/*.js"],
  "exclude": [
    "test/**",
    "**/*.test.ts",
    "**/*.d.ts",
    "src/extension.ts",
    "src/csvEditorProvider.ts",
    "src/parquetEditorProvider.ts",
    "src/sqliteEditorProvider.ts",
    "src/xlsxEditorProvider.ts",
    "src/duckdbEditorProvider.ts",
    "src/webviewHtml.ts"
  ],
  "extension": [".ts", ".js"],
  "all": true,
  "lines": 80,
  "check-coverage": true
}
